package com.mrcrayfish.device.programs;

import com.mrcrayfish.device.api.app.Application;
import com.mrcrayfish.device.api.app.Icons;
import com.mrcrayfish.device.api.app.Layout;
import com.mrcrayfish.device.api.app.component.Button;
import com.mrcrayfish.device.api.app.component.CheckBox;
import com.mrcrayfish.device.api.app.component.Label;
import com.mrcrayfish.device.object.Game;
import com.mrcrayfish.device.object.TileGrid;
import com.mrcrayfish.device.object.tiles.Tile;
import net.minecraft.nbt.NBTTagCompound;

import javax.annotation.Nullable;

public class ApplicationBoatRacers extends Application
{
    private Layout layoutWorlds;
    private Layout layoutEditor;

    private Game game;
    private TileGrid tileGrid;

    private Label labelLayer;
    private Label labelStatus;

    private CheckBox checkBoxForeground;
    private CheckBox checkBoxBackground;
    private CheckBox checkBoxPlayer;

    private NBTTagCompound savedWorlds = new NBTTagCompound();
    private int selectedSlot = 1;

    public ApplicationBoatRacers()
    {
        this.setDefaultWidth(410);
        this.setDefaultHeight(210);
    }

    @Override
    public void init(@Nullable NBTTagCompound intent)
    {
        showWorldMenu();
    }

    private void showWorldMenu()
    {
        layoutWorlds = new Layout(410, 210);

        Label title = new Label("Boat Racers Worlds", 10, 8);
        layoutWorlds.addComponent(title);

        Label hint = new Label("Select a saved world slot", 10, 24);
        layoutWorlds.addComponent(hint);

        for(int i = 1; i <= 5; i++)
        {
            final int slot = i;
            String prefix = selectedSlot == slot ? "> " : "  ";
            String state = hasSavedWorld(slot) ? "SAVED" : "EMPTY";

            Button slotButton = new Button(10, 42 + ((slot - 1) * 24), prefix + "Slot " + slot + "  -  " + state);
            slotButton.setSize(240, 22);
            slotButton.setClickListener((mouseX, mouseY, mouseButton) ->
            {
                selectedSlot = slot;
                showWorldMenu();
            });
            layoutWorlds.addComponent(slotButton);
        }

        Button btnNew = new Button(280, 42, "New");
        btnNew.setSize(100, 28);
        btnNew.setClickListener((mouseX, mouseY, mouseButton) -> openEditor(true));
        layoutWorlds.addComponent(btnNew);

        Button btnOpen = new Button(280, 82, "Open");
        btnOpen.setSize(100, 28);
        btnOpen.setClickListener((mouseX, mouseY, mouseButton) -> openEditor(false));
        layoutWorlds.addComponent(btnOpen);

        Button btnDelete = new Button(280, 122, "Delete");
        btnDelete.setSize(100, 28);
        btnDelete.setClickListener((mouseX, mouseY, mouseButton) ->
        {
            deleteSelectedWorld();
            showWorldMenu();
        });
        layoutWorlds.addComponent(btnDelete);

        Label bottom = new Label("Selected: Slot " + selectedSlot, 10, 176);
        layoutWorlds.addComponent(bottom);

        setCurrentLayout(layoutWorlds);
    }

    private void openEditor(boolean fresh)
    {
        layoutEditor = new Layout(410, 210);

        try
        {
            game = new Game(4, 4, 256, 144);
            game.setEditorMode(true);
            game.setRenderPlayer(true);
            game.fill(Tile.grass);
            game.setCurrentTile(Tile.water);
            game.setCurrentLayer(Game.Layer.BACKGROUND);
            layoutEditor.addComponent(game);
        }
        catch(Exception e)
        {
            e.printStackTrace();
        }

        tileGrid = new TileGrid(266, 3, game);
        layoutEditor.addComponent(tileGrid);

        labelLayer = new Label("Layer 1", 270, 108);
        layoutEditor.addComponent(labelLayer);

        Button btnPrevLayer = new Button(266, 124, Icons.CHEVRON_LEFT);
        btnPrevLayer.setClickListener((mouseX, mouseY, mouseButton) ->
        {
            game.prevLayer();
            labelLayer.setText("Layer " + (game.getCurrentLayer().layer + 1));
        });
        layoutEditor.addComponent(btnPrevLayer);

        Button btnNextLayer = new Button(314, 124, Icons.CHEVRON_RIGHT);
        btnNextLayer.setClickListener((mouseX, mouseY, mouseButton) ->
        {
            game.nextLayer();
            labelLayer.setText("Layer " + (game.getCurrentLayer().layer + 1));
        });
        layoutEditor.addComponent(btnNextLayer);

        Button btnSave = new Button(266, 150, "Save");
        btnSave.setSize(55, 20);
        btnSave.setClickListener((mouseX, mouseY, mouseButton) -> saveCurrentWorld(true));
        layoutEditor.addComponent(btnSave);

        Button btnMenu = new Button(326, 150, "Menu");
        btnMenu.setSize(55, 20);
        btnMenu.setClickListener((mouseX, mouseY, mouseButton) ->
        {
            saveCurrentWorld(false);
            showWorldMenu();
        });
        layoutEditor.addComponent(btnMenu);

        checkBoxBackground = new CheckBox("BG", 3, 151);
        checkBoxBackground.setClickListener((mouseX, mouseY, mouseButton) -> game.setRenderBackground(checkBoxBackground.isSelected()));
        checkBoxBackground.setSelected(true);
        layoutEditor.addComponent(checkBoxBackground);

        checkBoxForeground = new CheckBox("FG", 50, 151);
        checkBoxForeground.setClickListener((mouseX, mouseY, mouseButton) -> game.setRenderForeground(checkBoxForeground.isSelected()));
        checkBoxForeground.setSelected(true);
        layoutEditor.addComponent(checkBoxForeground);

        checkBoxPlayer = new CheckBox("Player", 96, 151);
        checkBoxPlayer.setClickListener((mouseX, mouseY, mouseButton) -> game.setRenderPlayer(checkBoxPlayer.isSelected()));
        checkBoxPlayer.setSelected(true);
        layoutEditor.addComponent(checkBoxPlayer);

        labelStatus = new Label("Slot " + selectedSlot, 3, 176);
        layoutEditor.addComponent(labelStatus);

        setCurrentLayout(layoutEditor);

        if(fresh)
        {
            setStatus("New world in slot " + selectedSlot);
        }
        else
        {
            if(hasSavedWorld(selectedSlot))
            {
                loadSelectedWorld(true);
            }
            else
            {
                setStatus("Slot " + selectedSlot + " is empty - new world");
            }
        }
    }

    private String key(int slot, String name)
    {
        return "slot" + slot + "_" + name;
    }

    private String key(String name)
    {
        return key(selectedSlot, name);
    }

    private boolean hasSavedWorld(int slot)
    {
        return savedWorlds.hasKey(key(slot, "width")) && savedWorlds.hasKey(key(slot, "height"));
    }

    private void saveCurrentWorld(boolean showStatus)
    {
        if(game == null)
        {
            return;
        }

        int[][] data = game.exportMap();

        savedWorlds.setInteger(key("width"), game.mapWidth);
        savedWorlds.setInteger(key("height"), game.mapHeight);

        for(int layer = 0; layer < 4; layer++)
        {
            savedWorlds.setIntArray(key("layer" + layer), data[layer]);
        }

        if(showStatus)
        {
            setStatus("Saved slot " + selectedSlot);
        }
    }

    private void loadSelectedWorld(boolean showStatus)
    {
        if(game == null)
        {
            return;
        }

        if(!hasSavedWorld(selectedSlot))
        {
            if(showStatus)
            {
                setStatus("Slot " + selectedSlot + " is empty.");
            }
            return;
        }

        int width = savedWorlds.getInteger(key("width"));
        int height = savedWorlds.getInteger(key("height"));

        int[][] data = new int[4][];

        for(int layer = 0; layer < 4; layer++)
        {
            data[layer] = savedWorlds.getIntArray(key("layer" + layer));
        }

        boolean loaded = game.loadMap(width, height, data);

        if(showStatus)
        {
            setStatus(loaded ? "Loaded slot " + selectedSlot : "Load failed.");
        }
    }

    private void deleteSelectedWorld()
    {
        savedWorlds.removeTag(key("width"));
        savedWorlds.removeTag(key("height"));

        for(int layer = 0; layer < 4; layer++)
        {
            savedWorlds.removeTag(key("layer" + layer));
        }
    }

    private void setStatus(String text)
    {
        if(labelStatus != null)
        {
            labelStatus.setText(text);
        }
    }

    @Override
    public void load(NBTTagCompound tagCompound)
    {
        if(tagCompound == null)
        {
            return;
        }

        selectedSlot = tagCompound.getInteger("selectedSlot");

        if(selectedSlot < 1 || selectedSlot > 5)
        {
            selectedSlot = 1;
        }

        if(tagCompound.hasKey("boatWorlds"))
        {
            savedWorlds = tagCompound.getCompoundTag("boatWorlds");
        }
        else
        {
            savedWorlds = new NBTTagCompound();
        }
    }

    @Override
    public void save(NBTTagCompound tagCompound)
    {
        if(tagCompound == null)
        {
            return;
        }

        if(game != null)
        {
            saveCurrentWorld(false);
        }

        tagCompound.setInteger("selectedSlot", selectedSlot);
        tagCompound.setTag("boatWorlds", savedWorlds);
    }
}